{
  "$schema": "https://raw.githubusercontent.com/can1357/oh-my-pi/main/packages/coding-agent/src/config/mcp-schema.json",
  "mcpServers": {
    "agentmemory-vault": {
      "command": "python3",
      "args": ["/home/dev/AgentMemory/scripts/agent_memory_mcp.py"]
    },
    "codegraph": {
      "command": "codegraph",
      "args": ["serve", "--mcp"]
    },
    "cua-driver": {
      "enabled": false,
      "command": "/home/dev/.local/bin/cua-driver",
      "args": ["mcp", "--no-overlay"]
    },
    "picklab": {
      "enabled": false,
      "command": "picklab",
      "args": ["mcp", "serve"]
    },
    "sentry": {
      "enabled": false,
      "type": "http",
      "url": "https://mcp.sentry.dev/mcp"
    },
    "stripe": {
      "enabled": false,
      "type": "http",
      "url": "https://mcp.stripe.com",
      "oauth": {
        "clientId": "oacli_UsBlZ6jiucaNw9",
        "redirectUri": "http://127.0.0.1:3000/callback",
        "callbackPort": 3000,
        "callbackPath": "/callback"
      }
    },
    "vercel": {
      "enabled": false,
      "type": "http",
      "url": "https://mcp.vercel.com/"
    }
  },
  "disabledServers": [
    "agentmemory_vault",
    "context7:context7",
    "supabase",
    "stripe:stripe",
    "vercel:vercel",
    "github:github",
    "vgv-ai-flutter-plugin:very-good-cli",
    "vgv-ai-flutter-plugin:dart",
    "claude-mem:mcp-search",
    "claude-mem",
    "openaideveloperdocs",
    "openaiDeveloperDocs",
    "supabase-computer-builder",
    "agentmemory"
  ]
}
