#
# ~/.bashrc
#

# If not running interactively, don't do anything
[[ $- != *i* ]] && return

alias ls='ls --color=auto'
alias grep='grep --color=auto'
PS1='[\u@\h \W]\$ '

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion

alias ccu='bunx ccusage --compact'

_agent_harness_preflight() {
  "$HOME/.local/bin/agent-harness-preflight" "$1"
}

claude() {
  _agent_harness_preflight claude || return
  command claude --dangerously-skip-permissions "$@"
}

codex() {
  _agent_harness_preflight codex || return
  command codex --yolo "$@"
}

grok() {
  _agent_harness_preflight grok || return
  command grok "$@"
}

pi() {
  _agent_harness_preflight pi || return
  command pi "$@"
}

omp() {
  _agent_harness_preflight omp || return
  command omp "$@"
}
