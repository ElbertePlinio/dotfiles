{{- if eq .chezmoi.os "darwin" -}}
{{ template "zshrc-darwin" . }}
{{- else if eq .chezmoi.os "linux" -}}
{{ template "zshrc-linux" . }}
{{- else -}}
{{ fail (printf "unsupported OS for .zshrc: %s" .chezmoi.os) }}
{{- end }}

# Machine-local settings stay outside this public repository.
[[ -r ~/.zshrc.local ]] && source ~/.zshrc.local
