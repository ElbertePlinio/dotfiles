{{- $tools := includeTemplate "agent-tools.json" . | fromJson -}}
{
  "hooks": {
    "SessionStart": [
{{ if $tools.aiMemory }}      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{{ $tools.aiMemory }} --data-dir {{ .chezmoi.homeDir }}/.local/share/ai-memory hook --event session-start --agent grok --server-url http://127.0.0.1:49374"
          }
        ]
      }{{ end }}
    ],
    "UserPromptSubmit": [
{{ if $tools.aiMemory }}      {
