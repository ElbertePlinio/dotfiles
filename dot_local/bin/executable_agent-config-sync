#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF' >&2
Usage: agent-config-sync <check|check-live|apply|doctor>

  check       Validate source templates and portable-skill symlink matrix
  check-live  Read-only live migration checks against $HOME
  apply       Source check, live preflight, scoped agent apply, then live check
  doctor      Diagnose required local agent harness configuration

Apply exit codes: 73 self-update apply failed; 74 batched apply failed;
75 the CLI updated itself — re-run apply once.
EOF
  exit 1
}

[[ $# -ge 1 ]] || usage

resolve_source() {
  if [[ -n "${CHEZMOI_SOURCE_DIR:-}" && -d "${CHEZMOI_SOURCE_DIR}" ]]; then
    printf '%s\n' "$CHEZMOI_SOURCE_DIR"
    return
  fi
  if command -v chezmoi >/dev/null 2>&1; then
    local s
    if s="$(chezmoi source-path 2>/dev/null)" && [[ -n "$s" && -d "$s" ]]; then
      printf '%s\n' "$s"
      return
    fi
  fi
  if [[ -d "${HOME}/.local/share/chezmoi" ]]; then
    printf '%s\n' "${HOME}/.local/share/chezmoi"
    return
  fi
  printf '%s\n' ''
}

SOURCE="$(resolve_source)"
if [[ -z "$SOURCE" || ! -f "$SOURCE/scripts/check-agent-config-sync.sh" ]]; then
  echo "agent-config-sync: cannot locate chezmoi source with scripts/check-agent-config-sync.sh" >&2
  exit 1
fi

CHECK="$SOURCE/scripts/check-agent-config-sync.sh"
PICKFORGE_LANES_CONFIGURE="$SOURCE/run_onchange_after_configure_pickforge_lanes_mcp.sh"
MANIFEST="$SOURCE/dot_agents/skill-targets.json"
RETIREMENT_LIST="$SOURCE/.chezmoiremove"
SRC=(--source "$SOURCE")

cmd_check() {
  bash "$CHECK"
}

cmd_check_live() {
  bash "$CHECK" --check-live-migration
}

cmd_strict_preflight() {
  bash "$CHECK" --check-live-migration --strict-preflight
}

cmd_doctor() {
  local catalog="${AGENT_DOCTOR_CATALOG:-$SOURCE/dot_agents/doctor-targets.json}"
  AGENT_DOCTOR_CATALOG="$catalog" bash "$SOURCE/scripts/agent-doctor.sh" "$@"
}

portable_link_targets() {
  [[ -f "$MANIFEST" ]] || {
    echo "agent-config-sync: portable skill manifest missing: $MANIFEST" >&2
    return 1
  }
  jq -r --arg home "$HOME" '
    . as $root
    | .skills | to_entries[]
    | .key as $skill
    | .value[] as $harness
    | $root.harnesses[$harness] as $h
    | select($h.discovery == "symlink")
    | ($h.skills_root
        | if startswith("~/") then $home + .[1:]
          elif . == "~" then $home
          else .
          end) + "/" + $skill
  ' "$MANIFEST"
}

load_retired_targets() {
  local path live seen='|'
  [[ -s "$RETIREMENT_LIST" ]] || {
    echo "agent-config-sync: retirement list is missing or empty: $RETIREMENT_LIST" >&2
    return 1
  }

  while IFS= read -r path || [[ -n "$path" ]]; do
    if [[ -z "$path" || ! "$path" =~ ^[A-Za-z0-9._/-]+$ \
      || "$path" == /* || "$path" == */ || "$path" == *//* \
      || "/$path/" == *"/../"* || "/$path/" == *"/./"* ]]; then
      echo "agent-config-sync: retirement list contains malformed target: ${path:-<empty>}" >&2
      return 1
    fi
    if [[ "$seen" == *"|$path|"* ]]; then
      echo "agent-config-sync: retirement list contains duplicate target: $path" >&2
      return 1
    fi
    seen="${seen}${path}|"
    live="$HOME/$path"
    if [[ -e "$live" || -L "$live" ]]; then
      apply_targets+=("$live")
    fi
  done <"$RETIREMENT_LIST"
}

filter_ignored_targets() {
  # Drop active targets that chezmoi does not manage on this machine
  # (e.g. OS-gated via .chezmoiignore) so a single wrong-OS target cannot
  # abort the whole apply. Retired targets are appended later, unfiltered.
  local managed_output target normalized entry keep
  local dslash='//' slash='/'
  local -a managed_entries=()
  apply_targets=()
  if ! managed_output="$(chezmoi "${SRC[@]}" managed \
    --include=files,symlinks,dirs --path-style=absolute)"; then
    echo "agent-config-sync: managed target enumeration failure" >&2
    return 1
  fi
  while IFS= read -r entry; do
    while [[ "$entry" == *"$dslash"* ]]; do entry="${entry//$dslash/$slash}"; done
    [[ -n "$entry" ]] && managed_entries+=("$entry")
  done <<<"$managed_output"
  for target in "$@"; do
    normalized="$target"
    while [[ "$normalized" == *"$dslash"* ]]; do normalized="${normalized//$dslash/$slash}"; done
    target="$normalized"
    keep=""
    for entry in "${managed_entries[@]}"; do
      if [[ "$entry" == "$target" || "$entry" == "$target"/* ]]; then
        keep=1
        break
      fi
    done
    if [[ -n "$keep" ]]; then
      apply_targets+=("$target")
    else
      echo "agent-config-sync: skipping target not managed on this machine: $target" >&2
    fi
  done
  if [[ "${#apply_targets[@]}" -eq 0 ]]; then
    echo "agent-config-sync: no active target is managed on this machine" >&2
    return 1
  fi
}

preflight_unmanaged_targets() {
  local target state managed_output
  local -a managed_targets
  if [[ "$#" -eq 0 ]]; then
    echo "agent-config-sync: active target list is empty" >&2
    return 1
  fi

  managed_targets=()
  if ! managed_output="$(mktemp "${TMPDIR:-/tmp}/agent-config-sync-managed.XXXXXX")"; then
    echo "agent-config-sync: managed target enumeration failure: cannot create temporary file" >&2
    return 1
  fi
  if ! chezmoi "${SRC[@]}" managed \
    --include=files,symlinks \
    --path-style=absolute \
    --nul-path-separator -- "$@" >"$managed_output"; then
    rm -f "$managed_output"
    echo "agent-config-sync: managed active target enumeration failure" >&2
    return 1
  fi
  while IFS= read -r -d '' target; do
    managed_targets+=("$target")
  done <"$managed_output"
  rm -f "$managed_output"
  if [[ "${#managed_targets[@]}" -eq 0 ]]; then
    echo "agent-config-sync: managed active target enumeration empty" >&2
    return 1
  fi

  for target in "${managed_targets[@]}"; do
    [[ -e "$target" || -L "$target" ]] || continue
    state="$(chezmoi state get --bucket=entryState --key="$target" 2>/dev/null || true)"
    [[ -n "$state" ]] && continue
    if chezmoi "${SRC[@]}" verify "$target" >/dev/null 2>&1; then
      continue
    fi
    echo "agent-config-sync: refusing to overwrite pre-existing unmanaged target: $target" >&2
    return 1
  done
}

summarize_applied_targets() {
  local output="$1" path
  local -a written_targets=()

  while IFS= read -r path; do
    [[ -n "$path" ]] && written_targets+=("$path")
  done < <(awk '
    /^diff --git a\// {
      path = $0
      sub(/^diff --git a\/.* b\//, "", path)
      if (!seen[path]++) print path
    }
  ' "$output")

  printf 'applied: %d targets\n' "${#written_targets[@]}"
  if [[ "${#written_targets[@]}" -gt 0 ]]; then
    for path in "${written_targets[@]}"; do
      if [[ "$path" == /* ]]; then
        printf 'applied: %s\n' "$path"
      else
        printf 'applied: %s/%s\n' "$HOME" "$path"
      fi
    done
  fi
}

cmd_apply() {
  local link portable_output work_dir self_before check_output apply_output self_target
  local -a active_targets=(
    "${HOME}/.zshrc"
    "${HOME}/.bashrc"
    "${HOME}/.claude/CLAUDE.md"
    "${HOME}/.codex/AGENTS.md"
    "${HOME}/.codex/skills/model-orchestration"
    "${HOME}/.codex/skills/ship-pr"
    "${HOME}/.grok/AGENTS.md"
    "${HOME}/.grok/skills/model-orchestration"
    "${HOME}/.pi/agent/AGENTS.md"
    "${HOME}/.pi/agent/settings.json"
    "${HOME}/.pi/agent/extensions/btw.ts"
    "${HOME}/.pi/agent/extensions/decision-audit-gate.ts"
    "${HOME}/.omp/agent/AGENTS.md"
    "${HOME}/.omp/agent/config.yml"
    "${HOME}/.omp/agent/agents"
    "${HOME}/.omp/agent/mcp.json"
    "${HOME}/.omp/agent/extensions/decision-audit-gate.ts"
    "${HOME}/.agents/.skill-lock.json"
    "${HOME}/.agents/mcp-targets.json"
    "${HOME}/.agents/skill-targets.json"
    "${HOME}/.agents/desktop-capture.md"
    "${HOME}/.agents/browser-use.md"
    "${HOME}/.agents/codex-lane-override.md"
    "${HOME}/.hermes/SOUL.md"
    "${HOME}/.agents/skills"
    "${HOME}/.local/bin/pickforge-lanes-mcp"
    "${HOME}/.local/bin/sudo-askpass"
    "${HOME}/.config/environment.d/50-sudo-askpass.conf"
    "${HOME}/.config/environment.d/60-omp.conf"
    "${HOME}/.config/environment.d/70-pi-caffeinate.conf"
    "${HOME}/.claude/rules"
    "${HOME}/.claude/settings.json"
    "${HOME}/.claude/hooks/decision-audit-gate.sh"
    "${HOME}/.claude/skills/kickoff"
    "${HOME}/.claude/skills/ship-pr"
    "${HOME}/.claude/skills/pickgauge-usage"
    "${HOME}/.claude/skills/plan-issue"
    "${HOME}/.claude/skills/x-research"
  )
  local -a apply_targets=()

  if ! work_dir="$(mktemp -d "${TMPDIR:-/tmp}/agent-config-sync-apply.XXXXXX")"; then
    echo "agent-config-sync: cannot create private apply workspace" >&2
    return 1
  fi
  chmod 0700 "$work_dir"
  trap '[ -z "${work_dir:-}" ] || rm -rf "$work_dir"' EXIT
  self_before="$work_dir/agent-config-sync.before"
  check_output="$work_dir/check.log"
  apply_output="$work_dir/apply.log"
  self_target="${HOME}/.local/bin/agent-config-sync"

  if ! cp "$self_target" "$self_before"; then
    echo "agent-config-sync: cannot snapshot running CLI" >&2
    rm -rf "$work_dir"
    return 1
  fi
  if ! chezmoi "${SRC[@]}" apply --force --no-tty -- "$self_target" \
    >"$work_dir/self-update.log" 2>&1; then
    cat "$work_dir/self-update.log" >&2
    echo "agent-config-sync: self-update chezmoi apply failed" >&2
    rm -rf "$work_dir"
    return 73
  fi
  if ! cmp -s "$self_before" "$self_target"; then
    echo "agent-config-sync updated; re-run apply" >&2
    rm -rf "$work_dir"
    return 75
  fi

  if ! cmd_check >"$check_output" 2>&1; then
    cat "$check_output" >&2
    echo "agent-config-sync: source check failed" >&2
    rm -rf "$work_dir"
    return 1
  fi
  if ! cmd_strict_preflight >"$check_output" 2>&1; then
    cat "$check_output" >&2
    echo "agent-config-sync: strict preflight failed" >&2
    rm -rf "$work_dir"
    return 1
  fi
  mkdir -p \
    "${HOME}/.claude/rules" \
    "${HOME}/.claude/hooks" \
    "${HOME}/.claude/skills" \
    "${HOME}/.codex/skills" \
    "${HOME}/.grok/skills" \
    "${HOME}/.pi/agent/extensions" \
    "${HOME}/.pi/agent/skills" \
    "${HOME}/.omp/agent/extensions" \
    "${HOME}/.omp/agent/skills" \
    "${HOME}/.agents/skills" \
    "${HOME}/.hermes" \
    "${HOME}/.local/bin"
  if ! portable_output="$(portable_link_targets)"; then
    echo "agent-config-sync: cannot build portable skill targets" >&2
    return 1
  fi
  while IFS= read -r link; do
    [[ -n "$link" ]] && active_targets+=("$link")
  done <<<"$portable_output"
  if [[ "${#active_targets[@]}" -eq 0 ]]; then
    echo "agent-config-sync: active target list is empty" >&2
    return 1
  fi
  filter_ignored_targets "${active_targets[@]}"
  for target in "${apply_targets[@]}"; do
    if [[ "$target" == "${HOME}/.config/environment.d/"* ]]; then
      mkdir -p "${HOME}/.config/environment.d"
      break
    fi
  done
  preflight_unmanaged_targets "${apply_targets[@]}"
  load_retired_targets
  if ! chezmoi "${SRC[@]}" apply --verbose --force --no-tty -- "${apply_targets[@]}" \
    >"$apply_output" 2>&1; then
    cat "$apply_output" >&2
    echo "agent-config-sync: batched chezmoi apply failed" >&2
    rm -rf "$work_dir"
    return 74
  fi
  summarize_applied_targets "$apply_output"
  if [[ ! -f "$PICKFORGE_LANES_CONFIGURE" ]]; then
    echo "agent-config-sync: pickforge-lanes MCP configure script missing: $PICKFORGE_LANES_CONFIGURE" >&2
    rm -rf "$work_dir"
    return 1
  fi
  if ! sh "$PICKFORGE_LANES_CONFIGURE"; then
    echo "agent-config-sync: pickforge-lanes MCP registration failed" >&2
    rm -rf "$work_dir"
    return 1
  fi
  if ! bash "$CHECK" --check-live-migration >"$check_output" 2>&1; then
    cat "$check_output" >&2
    echo "agent-config-sync: live check failed" >&2
    rm -rf "$work_dir"
    return 1
  fi
  rm -rf "$work_dir"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  case "${1:-}" in
    check) cmd_check ;;
    check-live) cmd_check_live ;;
    apply) cmd_apply ;;
    doctor) shift; cmd_doctor "$@" ;;
    *) usage ;;
  esac
fi
