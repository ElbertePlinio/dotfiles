#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF' >&2
Usage: agent-config-sync <check|check-live|apply>

  check       Validate source templates and portable-skill symlink matrix
  check-live  Read-only live migration / portable-link checks against $HOME
  apply       Source check, live preflight, selective apply, then live check
EOF
  exit 1
}

[[ $# -ge 1 ]] || usage

resolve_source() {
  if [[ -n "${CHEZMOI_SOURCE_DIR:-}" && -d "${CHEZMOI_SOURCE_DIR}" ]]; then
    printf '%s\n' "$CHEZMOI_SOURCE_DIR"
    return
  fi
  if command -v chezmoi >/dev/null 2>&1; then
    local s
    if s="$(chezmoi source-path 2>/dev/null)" && [[ -n "$s" && -d "$s" ]]; then
      printf '%s\n' "$s"
      return
    fi
  fi
  printf '%s\n' ''
}

SOURCE="$(resolve_source)"
if [[ -z "$SOURCE" || ! -f "$SOURCE/scripts/check-agent-config-sync.sh" ]]; then
  echo "agent-config-sync: cannot locate chezmoi source with scripts/check-agent-config-sync.sh" >&2
  exit 1
fi

CHECK="$SOURCE/scripts/check-agent-config-sync.sh"
MANIFEST="$SOURCE/dot_agents/skill-targets.json"
SRC=(--source "$SOURCE")

PROFILE_ROLE="$(
  if [[ -r "${HOME}/.config/agent-profiles/role" ]]; then
    tr -d '[:space:]' <"${HOME}/.config/agent-profiles/role"
  else
    chezmoi "${SRC[@]}" execute-template '{{ .agentProfile | default "restricted" }}'
  fi
)"
[[ "$PROFILE_ROLE" == main || "$PROFILE_ROLE" == restricted ]] || {
  echo "agent-config-sync: invalid profile role '$PROFILE_ROLE'" >&2
  exit 1
}

cmd_check() {
  bash "$CHECK"
}

cmd_check_live() {
  bash "$CHECK" --check-live-migration
}

cmd_strict_preflight() {
  bash "$CHECK" --check-live-migration --strict-preflight
}

portable_link_targets() {
  jq -r --arg home "$HOME" --arg role "$PROFILE_ROLE" '
    . as $root
    | .skills | to_entries[]
    | .key as $skill
    | .value[] as $harness
    | $root.harnesses[$harness] as $h
    | select($h.discovery == "symlink")
    | select($role == "main" or $harness != "claude")
    | ($h.skills_root | if startswith("~/") then $home + .[1:] elif . == "~" then $home else . end) + "/" + $skill
  ' "$MANIFEST"
}

bootstrap_real_gh() {
  local safety_dir real_gh candidate
  safety_dir="${HOME}/Projects/Personal/.agent-safety"
  real_gh="${safety_dir}/real-gh"

  if [[ -e "$real_gh" || -L "$real_gh" ]]; then
    [[ -x "$real_gh" ]] || {
      echo "agent-config-sync: Personal GitHub real-gh exists but is not executable: $real_gh" >&2
      return 1
    }
    return
  fi

  for candidate in /usr/bin/gh /usr/local/bin/gh /opt/homebrew/bin/gh /opt/local/bin/gh; do
    if [[ -x "$candidate" ]]; then
      ln -s "$candidate" "$real_gh"
      return
    fi
  done

  echo 'agent-config-sync: cannot find a system GitHub CLI for Personal real-gh' >&2
  return 1
}

preflight_unmanaged_targets() {
  local target state
  local -a managed_targets
  mapfile -d '' -t managed_targets < <(
    chezmoi "${SRC[@]}" managed \
      --include=files,symlinks \
      --path-style=absolute \
      --nul-path-separator \
      "$@"
  )

  for target in "${managed_targets[@]}"; do
    [[ -e "$target" || -L "$target" ]] || continue
    state="$(chezmoi state get --bucket=entryState --key="$target" 2>/dev/null || true)"
    [[ -n "$state" ]] && continue
    if chezmoi "${SRC[@]}" verify "$target" >/dev/null 2>&1; then
      continue
    fi
    echo "agent-config-sync: refusing to overwrite pre-existing unmanaged target: $target" >&2
    return 1
  done
}

remove_obsolete_portable_skill() {
  local skill="$1"
  local dir="${HOME}/.claude-personal/skills/${skill}"
  local live="${dir}/SKILL.md"
  local source_age="${SOURCE}/dot_claude/skills/${skill}/encrypted_SKILL.md.age"
  local rendered actual_hash legacy_hash
  local source_matches=0
  local -a entries

  case "$skill" in
    codex-fable) legacy_hash='ff2e124c935ae773d1be21aac4c990fe773e4979547ea88086925abfecb55a96' ;;
    codex-opus) legacy_hash='7cdb683091226a41760b265da01d22011ad97f01e47b904730ff0410bba874e0' ;;
    kickoff) legacy_hash='d15b84f6030291cb1598cf833778124fe771483f4172d04645f5da736f0ac317' ;;
    ship-pr) legacy_hash='2b3cd186b5d339dca2907cf963cccaaf7b71a75cfc0339556fb1d752e91dd82d' ;;
    *) echo "agent-config-sync: unknown obsolete portable skill: $skill" >&2; return 1 ;;
  esac

  [[ -e "$dir" || -L "$dir" ]] || return 0
  [[ -d "$dir" && ! -L "$dir" ]] || {
    echo "agent-config-sync: refusing to remove unexpected portable skill path: $dir" >&2
    return 1
  }
  shopt -s nullglob dotglob
  entries=("$dir"/*)
  shopt -u nullglob dotglob
  [[ "${#entries[@]}" -eq 1 && "${entries[0]}" == "$live" && -f "$live" && ! -L "$live" ]] || {
    echo "agent-config-sync: refusing to remove modified portable skill directory: $dir" >&2
    return 1
  }

  rendered="$(mktemp "${TMPDIR:-/tmp}/agent-config-sync-portable-skill.XXXXXX")"
  if chezmoi "${SRC[@]}" decrypt "$source_age" >"$rendered" && cmp -s "$live" "$rendered"; then
    source_matches=1
  fi
  rm -f "$rendered"
  read -r actual_hash _ < <(sha256sum "$live")
  if [[ "$source_matches" -ne 1 && "$actual_hash" != "$legacy_hash" ]]; then
    echo "agent-config-sync: refusing to remove divergent portable skill: $live" >&2
    return 1
  fi

  rm -f "$live"
  rmdir "$dir"
}

remove_obsolete_portable_paths() {
  local skill link target workflow workflow_hash
  for skill in codex-fable codex-opus kickoff ship-pr; do
    remove_obsolete_portable_skill "$skill"
  done

  for skill in agent-config-sync local-review; do
    link="${HOME}/.claude-personal/skills/${skill}"
    [[ -e "$link" || -L "$link" ]] || continue
    target="../../.agents/skills/${skill}"
    [[ -L "$link" && "$(readlink "$link")" == "$target" ]] || {
      echo "agent-config-sync: refusing to remove divergent portable skill link: $link" >&2
      return 1
    }
    rm -f "$link"
  done

  workflow="${HOME}/.claude-personal/codex-opus-workflow.html"
  if [[ -e "$workflow" || -L "$workflow" ]]; then
    [[ -f "$workflow" && ! -L "$workflow" ]] || {
      echo "agent-config-sync: refusing to remove unexpected portable workflow: $workflow" >&2
      return 1
    }
    read -r workflow_hash _ < <(sha256sum "$workflow")
    if ! cmp -s "$workflow" "${SOURCE}/dot_claude/codex-opus-workflow.html" \
      && [[ "$workflow_hash" != 'de5efd7678c7d537090486178690e6b3a5805947fadd322ac65a807977bfd40d' ]]; then
      echo "agent-config-sync: refusing to remove divergent portable workflow: $workflow" >&2
      return 1
    fi
    rm -f "$workflow"
  fi
}

cmd_apply() {
  cmd_check
  cmd_strict_preflight

  mkdir -p \
    "${HOME}/.config/agent-profiles" \
    "${HOME}/.claude-personal/rules" \
    "${HOME}/.claude-personal/skills/codex" \
    "${HOME}/.codex/skills/model-orchestration/references" \
    "${HOME}/.codex/skills/ship-pr" \
    "${HOME}/.grok/skills/model-orchestration" \
    "${HOME}/Projects/Personal/.codex" \
    "${HOME}/Projects/Personal/.agent-safety/bin" \
    "${HOME}/Projects/Personal/.agent-safety/hooks"

  local -a targets=(
    "${HOME}/.config/agent-profiles/role"
    "${HOME}/.config/agent-profiles/personal-roots"
    "${HOME}/.local/bin/claude-profile"
    "${HOME}/.local/bin/claude-default"
    "${HOME}/.local/bin/claude-personal"
    "${HOME}/.local/bin/agent-profile-doctor"
    "${HOME}/.zshrc"
    "${HOME}/.bashrc"
    "${HOME}/.claude/CLAUDE.md"
    "${HOME}/.claude-personal/CLAUDE.md"
    "${HOME}/.claude-personal/RTK.md"
    "${HOME}/.claude-personal/rules"
    "${HOME}/.claude-personal/settings.json"
    "${HOME}/.claude-personal/skills/codex"
    "${HOME}/.codex/AGENTS.md"
    "${HOME}/.codex/skills/model-orchestration/SKILL.md"
    "${HOME}/.codex/skills/model-orchestration/references/model-routing.md"
    "${HOME}/Projects/Personal/.codex/config.toml"
    "${HOME}/Projects/Personal/.codex/AGENTS.md"
    "${HOME}/Projects/Personal/.codex/skills"
    "${HOME}/Projects/Personal/.agent-safety/bin/gh"
    "${HOME}/Projects/Personal/.agent-safety/bin/gh-credential"
    "${HOME}/Projects/Personal/.agent-safety/verify-personal-github"
    "${HOME}/Projects/Personal/.agent-safety/install-repo-hook"
    "${HOME}/Projects/Personal/.agent-safety/hooks/pre-push"
    "${HOME}/.grok/AGENTS.md"
    "${HOME}/.pi/agent/AGENTS.md"
    "${HOME}/.omp/agent/AGENTS.md"
    "${HOME}/.omp/agent/config.yml"
    "${HOME}/.omp/agent/agents"
    "${HOME}/.omp/agent/mcp.json"
    "${HOME}/.factory/AGENTS.md"
    "${HOME}/.factory/hooks/model-flow-reminder.sh"
    "${HOME}/.config/opencode/AGENTS.md"
    "${HOME}/.agents/mcp-targets.json"
    "${HOME}/.agents/skill-targets.json"
    "${HOME}/.hermes/SOUL.md"
    "${HOME}/.agents/skills"
    "${HOME}/.local/bin/agent-config-sync"
    "${HOME}/.local/bin/sudo-askpass"
    "${HOME}/.config/environment.d/50-sudo-askpass.conf"
    "${HOME}/.config/environment.d/60-omp.conf"
    "${HOME}/.codex/skills/model-orchestration"
    "${HOME}/.codex/skills/ship-pr"
    "${HOME}/.grok/skills/model-orchestration"
  )

  if [[ "$PROFILE_ROLE" == main ]]; then
    mkdir -p \
      "${HOME}/.claude/rules" \
      "${HOME}/.claude/skills/codex" \
      "${HOME}/.claude/skills/codex-fable" \
      "${HOME}/.claude/skills/codex-opus" \
      "${HOME}/.claude/skills/kickoff" \
      "${HOME}/.claude/skills/ship-pr" \
      "${HOME}/.claude/skills/grok" \
      "${HOME}/.claude/skills/pickgauge-usage" \
      "${HOME}/.claude/skills/plan-issue" \
      "${HOME}/.claude/skills/x-research"
    targets+=(
      "${HOME}/.claude/RTK.md"
      "${HOME}/.claude/codex-opus-workflow.html"
      "${HOME}/.claude/rules"
      "${HOME}/.claude/settings.json"
      "${HOME}/.claude/skills/codex"
      "${HOME}/.claude/skills/codex-fable"
      "${HOME}/.claude/skills/codex-opus"
      "${HOME}/.claude/skills/kickoff"
      "${HOME}/.claude/skills/ship-pr"
      "${HOME}/.claude/skills/grok"
      "${HOME}/.claude/skills/pickgauge-usage"
      "${HOME}/.claude/skills/plan-issue"
      "${HOME}/.claude/skills/x-research"
    )
  fi

  local link
  while IFS= read -r link; do
    [[ -n "$link" ]] && targets+=("$link")
  done < <(portable_link_targets)

  preflight_unmanaged_targets "${targets[@]}"
  remove_obsolete_portable_paths
  bootstrap_real_gh

  chezmoi "${SRC[@]}" apply --no-tty "${targets[@]}"
  bash "$CHECK" --check-live-migration --require-portable-links
}

case "${1}" in
  check) cmd_check ;;
  check-live) cmd_check_live ;;
  apply) cmd_apply ;;
  *) usage ;;
esac
