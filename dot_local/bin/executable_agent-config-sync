#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF' >&2
Usage: agent-config-sync <check|check-live|apply|sync|doctor>

  check       Validate the dotfiles source
  check-live  Read-only checks of live agent configuration
  apply       Source check, full guarded chezmoi apply, then live check
  sync        Fast-forward dotfiles and AgentMemory, then run apply
  doctor      Diagnose required local agent harness configuration

Every full apply runs scripts/apply-guard.sh first. It stops the apply when a
target holds content that chezmoi did not write. Sync exit code: 76 dotfiles
source is not clean on main or could not be fast-forwarded.
EOF
  exit 1
}

[[ $# -ge 1 ]] || usage

resolve_source() {
  if [[ -n "${CHEZMOI_SOURCE_DIR:-}" && -d "${CHEZMOI_SOURCE_DIR}" ]]; then
    printf '%s\n' "$CHEZMOI_SOURCE_DIR"
    return
  fi
  if command -v chezmoi >/dev/null 2>&1; then
    local s
    if s="$(chezmoi source-path 2>/dev/null)" && [[ -n "$s" && -d "$s" ]]; then
      printf '%s\n' "$s"
      return
    fi
  fi
  if [[ -d "${HOME}/.local/share/chezmoi" ]]; then
    printf '%s\n' "${HOME}/.local/share/chezmoi"
    return
  fi
  printf '%s\n' ''
}

SOURCE="$(resolve_source)"
if [[ -z "$SOURCE" || ! -f "$SOURCE/scripts/check-agent-config-sync.sh" ]]; then
  echo "agent-config-sync: cannot locate chezmoi source with scripts/check-agent-config-sync.sh" >&2
  exit 1
fi

CHECK="$SOURCE/scripts/check-agent-config-sync.sh"
SRC=(--source "$SOURCE")

cmd_check() {
  bash "$CHECK"
}

cmd_check_live() {
  bash "$CHECK" --check-live-migration
}

cmd_doctor() {
  local catalog="${AGENT_DOCTOR_CATALOG:-$SOURCE/dot_agents/doctor-targets.json}"
  AGENT_DOCTOR_CATALOG="$catalog" bash "$SOURCE/scripts/agent-doctor.sh" "$@"
}

cmd_sync() {
  local branch source_status pull_output dotfiles_commit
  local memory_status memory_result memory_commit apply_status
  local memory_repo="$HOME/AgentMemory"

  if ! branch="$(git -C "$SOURCE" branch --show-current 2>/dev/null)" \
    || [[ "$branch" != main ]]; then
    echo "agent-config-sync: dotfiles source must be on branch main" >&2
    return 76
  fi
  if ! source_status="$(git -C "$SOURCE" status --porcelain 2>&1)"; then
    printf '%s\n' "$source_status" >&2
    echo "agent-config-sync: cannot inspect dotfiles source working tree" >&2
    return 76
  fi
  if [[ -n "$source_status" ]]; then
    echo "agent-config-sync: dotfiles source has local changes; sync requires a clean working tree" >&2
    return 76
  fi
  if ! pull_output="$(git -C "$SOURCE" pull --ff-only 2>&1)"; then
    printf '%s\n' "$pull_output" >&2
    echo "agent-config-sync: dotfiles pull --ff-only failed" >&2
    return 76
  fi
  dotfiles_commit="$(git -C "$SOURCE" rev-parse --short HEAD)"

  if [[ ! -d "$memory_repo" ]]; then
    echo "AgentMemory missing; apply will clone it" >&2
    memory_result=missing
  elif ! memory_status="$(git -C "$memory_repo" status --porcelain 2>&1)"; then
    echo "AgentMemory is not a Git working tree; skipping pull" >&2
    memory_result=not-git
  elif [[ -n "$memory_status" ]]; then
    echo "AgentMemory has local changes; skipping pull" >&2
    memory_result=dirty
  elif ! pull_output="$(git -C "$memory_repo" pull --ff-only 2>&1)"; then
    printf '%s\n' "$pull_output" >&2
    echo "AgentMemory pull --ff-only failed; manual reconcile required" >&2
    memory_result=pull-failed
  else
    memory_commit="$(git -C "$memory_repo" rev-parse --short HEAD)"
    memory_result="$memory_commit"
  fi

  if cmd_apply; then
    apply_status=0
  else
    apply_status=$?
  fi
  if [[ "$apply_status" -eq 0 ]]; then
    printf 'sync: dotfiles=%s AgentMemory=%s apply=ok\n' \
      "$dotfiles_commit" "$memory_result"
  else
    printf 'sync: dotfiles=%s AgentMemory=%s apply=exit-%s\n' \
      "$dotfiles_commit" "$memory_result" "$apply_status"
  fi
  return "$apply_status"
}

# A full apply: every managed target, .chezmoiremove, and the run scripts.
# The apply guard script runs first inside chezmoi, so --force only skips
# prompts for changes the guard already allowed.
cmd_apply() {
  local log status_output line
  local -a pending=()

  APPLY_LOG="$(mktemp "${TMPDIR:-/tmp}/agent-config-sync.XXXXXX")"
  trap 'rm -f "$APPLY_LOG"' EXIT
  log="$APPLY_LOG"
  if ! cmd_check >"$log" 2>&1; then
    cat "$log" >&2
    echo "agent-config-sync: source check failed" >&2
    return 1
  fi
  if ! status_output="$(chezmoi "${SRC[@]}" status --exclude=scripts --path-style=absolute)"; then
    echo "agent-config-sync: chezmoi status failed" >&2
    return 1
  fi
  # A blank second column means the target already matches the source.
  while IFS= read -r line; do
    if [[ -n "$line" && "${line:1:1}" != ' ' ]]; then
      pending+=("${line:3}")
    fi
  done <<<"$status_output"
  if ! chezmoi "${SRC[@]}" apply --force --no-tty; then
    echo "agent-config-sync: chezmoi apply failed" >&2
    return 1
  fi
  printf 'applied: %d targets\n' "${#pending[@]}"
  for line in ${pending[@]+"${pending[@]}"}; do
    printf 'applied: %s\n' "$line"
  done
  if ! cmd_check_live >"$log" 2>&1; then
    cat "$log" >&2
    echo "agent-config-sync: live check failed" >&2
    return 1
  fi
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  case "${1:-}" in
    check) cmd_check ;;
    check-live) cmd_check_live ;;
    apply) cmd_apply ;;
    sync) cmd_sync ;;
    doctor) shift; cmd_doctor "$@" ;;
    *) usage ;;
  esac
fi
