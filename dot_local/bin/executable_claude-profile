#!/bin/sh
set -eu

role_file="${HOME}/.config/agent-profiles/role"
roots_file="${HOME}/.config/agent-profiles/personal-roots"
role="restricted"
if [ -r "$role_file" ]; then
  role=$(tr -d '[:space:]' <"$role_file")
fi
case "$role" in
  main|restricted) ;;
  *)
    echo "claude-profile: invalid role '$role' in $role_file" >&2
    exit 2
    ;;
esac

find_claude() {
  if [ -n "${CLAUDE_REAL_BIN:-}" ] && [ -x "$CLAUDE_REAL_BIN" ]; then
    printf '%s\n' "$CLAUDE_REAL_BIN"
    return
  fi
  for candidate in \
    "$HOME/.local/bin/claude" \
    /opt/homebrew/bin/claude \
    /usr/local/bin/claude \
    /usr/bin/claude; do
    if [ -x "$candidate" ]; then
      printf '%s\n' "$candidate"
      return
    fi
  done
  candidate=$(command -v claude 2>/dev/null || true)
  if [ -n "$candidate" ] && [ -x "$candidate" ]; then
    printf '%s\n' "$candidate"
    return
  fi
  echo 'claude-profile: Claude Code executable not found' >&2
  exit 127
}

path_is_under() {
  candidate_path=$1
  root_path=$2
  [ "$candidate_path" = "$root_path" ] || [ "${candidate_path#"$root_path"/}" != "$candidate_path" ]
}

is_personal_context() {
  current=$(pwd -P)
  git_common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)
  [ -r "$roots_file" ] || return 1

  while IFS= read -r configured_root || [ -n "$configured_root" ]; do
    case "$configured_root" in
      ''|'#'*) continue ;;
      '~/'*) configured_root="$HOME/${configured_root#\~/}" ;;
    esac
    if [ -d "$configured_root" ]; then
      configured_root=$(CDPATH= cd -- "$configured_root" && pwd -P)
    fi
    if path_is_under "$current" "$configured_root"; then
      return 0
    fi
    if [ -n "$git_common" ] && path_is_under "$git_common" "$configured_root"; then
      return 0
    fi
  done <"$roots_file"
  return 1
}

reject_restricted_bypass() {
  expect_mode=0
  for argument in "$@"; do
    if [ "$expect_mode" -eq 1 ]; then
      [ "$argument" = manual ] || {
        echo 'claude-profile: restricted role fixes permission mode to manual' >&2
        exit 2
      }
      expect_mode=0
      continue
    fi
    case "$argument" in
      --dangerously-skip-permissions|--allow-dangerously-skip-permissions|--permission-mode=bypassPermissions)
        echo "claude-profile: '$argument' is disabled for the restricted role" >&2
        exit 2
        ;;
      --permission-mode)
        expect_mode=1
        ;;
      --permission-mode=manual)
        ;;
      --permission-mode=*)
        echo 'claude-profile: restricted role fixes permission mode to manual' >&2
        exit 2
        ;;
    esac
  done
  [ "$expect_mode" -eq 0 ] || {
    echo 'claude-profile: --permission-mode requires a value' >&2
    exit 2
  }
}

run_default() {
  claude_bin=$(find_claude)
  if [ "$role" = main ]; then
    exec "$claude_bin" --dangerously-skip-permissions "$@"
  fi
  reject_restricted_bypass "$@"
  exec "$claude_bin" --permission-mode manual "$@"
}

run_personal() {
  is_personal_context || {
    echo 'claude-profile: portable personal profile is limited to configured personal roots and their worktrees' >&2
    exit 2
  }
  claude_bin=$(find_claude)
  exec env \
    -u CLAUDE_CODE_USE_BEDROCK \
    -u AWS_ACCESS_KEY_ID \
    -u AWS_SECRET_ACCESS_KEY \
    -u AWS_SESSION_TOKEN \
    -u AWS_SECURITY_TOKEN \
    -u AWS_PROFILE \
    -u AWS_REGION \
    -u AWS_DEFAULT_REGION \
    -u AWS_ROLE_ARN \
    -u AWS_ROLE_SESSION_NAME \
    -u AWS_WEB_IDENTITY_TOKEN_FILE \
    -u AWS_SHARED_CREDENTIALS_FILE \
    -u AWS_CONFIG_FILE \
    -u AWS_CONTAINER_CREDENTIALS_FULL_URI \
    -u AWS_CONTAINER_CREDENTIALS_RELATIVE_URI \
    CLAUDE_CONFIG_DIR="$HOME/.claude-personal" \
    "$claude_bin" --dangerously-skip-permissions "$@"
}

print_doctor() {
  claude_bin=$(find_claude)
  if is_personal_context; then
    personal_here=yes
  else
    personal_here=no
  fi
  if [ "$role" = main ]; then
    default_permissions=bypass
  else
    default_permissions=manual
  fi
  if [ -n "${CLAUDE_CODE_USE_BEDROCK:-}" ]; then bedrock_env=set; else bedrock_env=unset; fi
  if [ -n "${AWS_PROFILE:-}" ]; then aws_profile=set; else aws_profile=unset; fi
  printf '%s\n' \
    "role=$role" \
    "default.config_dir=$HOME/.claude" \
    "default.permissions=$default_permissions" \
    "portable.config_dir=$HOME/.claude-personal" \
    "portable.allowed_here=$personal_here" \
    "claude.bin=$claude_bin" \
    "claude.version=$($claude_bin --version 2>/dev/null || printf unknown)" \
    "env.bedrock=$bedrock_env" \
    "env.aws_profile=$aws_profile" \
    "default.policy=$([ -f "$HOME/.claude/CLAUDE.md" ] && printf present || printf missing)" \
    "portable.policy=$([ -f "$HOME/.claude-personal/CLAUDE.md" ] && printf present || printf missing)"
}

case "${1:-default}" in
  default)
    shift
    run_default "$@"
    ;;
  personal)
    shift
    run_personal "$@"
    ;;
  doctor)
    shift
    [ "$#" -eq 0 ] || {
      echo 'usage: claude-profile doctor' >&2
      exit 2
    }
    print_doctor
    ;;
  *)
    echo 'usage: claude-profile {default|personal|doctor} [claude arguments...]' >&2
    exit 2
    ;;
esac
