#!/bin/sh
set -eu

cli="$HOME/Projects/Personal/pi-kit/cli/lanes.ts"

if ! command -v bun >/dev/null 2>&1; then
  printf '%s\n' 'error: bun is required for pickforge-lanes' >&2
  exit 127
fi
if [ ! -f "$cli" ]; then
  printf 'error: pickforge-lanes CLI not found: %s\n' "$cli" >&2
  exit 1
fi

exec bun "$cli" "$@"
