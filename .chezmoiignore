# The age identity decrypts every encrypted file here. Never manage it.
.config/chezmoi

# Hermes ships and curates its own skill library under ~/.hermes/skills, so it
# is not ours to version. Only the portable skill symlinks are, and those are
# direct children, so this ignores category contents without touching them.
# chezmoi's ** matches zero segments, so `*/**` would swallow the symlinks too.
.hermes/skills/*/*
.hermes/skills/.bundled_manifest
.hermes/skills/.curator_backups
.hermes/skills/.curator_state
.hermes/skills/.usage.json
.hermes/skills/.usage.json.lock
.hermes/skills/.hub

