#!/bin/sh
set -eu

script_path=$0
while [ -L "$script_path" ]; do
  link=$(readlink "$script_path")
  case "$link" in
    /*) script_path=$link ;;
    *) script_path=$(dirname -- "$script_path")/$link ;;
  esac
done

script_dir=$(CDPATH= cd -- "$(dirname -- "$script_path")" && pwd -P)
safety_dir=$(CDPATH= cd -- "$script_dir/.." && pwd -P)
personal_root=$(CDPATH= cd -- "$safety_dir/.." && pwd -P)
real_gh="$safety_dir/real-gh"
current_dir=$(pwd -P)

is_personal_context() {
  case "$current_dir/" in
    "$personal_root/"*) return 0 ;;
  esac

  git_common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 1
  case "$git_common/" in
    "$personal_root/"*) return 0 ;;
  esac
  return 1
}

if ! is_personal_context; then
  exec "$real_gh" "$@"
fi

if [ -f "$safety_dir/use-isolated-gh" ]; then
  export GH_CONFIG_DIR="$safety_dir/gh"
fi

case "${1-} ${2-}" in
  "auth login"|"auth status") exec "$real_gh" "$@" ;;
esac

login=$("$real_gh" api user --jq .login 2>/dev/null || true)
if [ "$login" != "ElbertePlinio" ]; then
  echo "Blocked: Personal projects require GitHub account ElbertePlinio (active: ${login:-none})." >&2
  echo "Authenticate with: gh auth login" >&2
  exit 1
fi

exec "$real_gh" "$@"
