#!/bin/sh
set -eu

safety_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
personal_root=$(CDPATH= cd -- "$safety_dir/.." && pwd -P)
real_gh="$safety_dir/real-gh"
current_dir=$(pwd -P)

is_personal_context() {
  case "$current_dir/" in
    "$personal_root/"*) return 0 ;;
  esac

  git_common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 1
  case "$git_common/" in
    "$personal_root/"*) return 0 ;;
  esac
  return 1
}

if ! is_personal_context; then
  echo "Blocked: current directory is not a Personal project or its worktree." >&2
  exit 1
fi

if [ -f "$safety_dir/use-isolated-gh" ]; then
  export GH_CONFIG_DIR="$safety_dir/gh"
fi

login=$("$real_gh" api user --jq .login 2>/dev/null || true)
if [ "$login" != "ElbertePlinio" ]; then
  echo "Blocked: expected GitHub account ElbertePlinio, got ${login:-none}." >&2
  exit 1
fi

if [ "${1-}" = "--push" ]; then
  remote_url=${2-}
  name=$(git config --get user.name 2>/dev/null || true)
  email=$(git config --get user.email 2>/dev/null || true)
  if [ "$name" != "Elberte Plinio" ] || [ "$email" != "89710472+ElbertePlinio@users.noreply.github.com" ]; then
    echo "Blocked: Personal Git author identity is not configured." >&2
    exit 1
  fi

  case "$remote_url" in
    git@github.com:*|ssh://git@github.com/*)
      ssh_result=$(ssh -o BatchMode=yes -o ConnectTimeout=5 -T git@github.com 2>&1 || true)
      case "$ssh_result" in
        *"Hi ElbertePlinio!"*) ;;
        *)
          echo "Blocked: GitHub SSH does not authenticate as ElbertePlinio." >&2
          exit 1
          ;;
      esac
      ;;
    https://github.com/*) ;;
  esac
fi

echo "Personal GitHub identity verified: ElbertePlinio"
