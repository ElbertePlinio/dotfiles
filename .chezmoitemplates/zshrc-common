_agent_harness_preflight() {
  "$HOME/.local/bin/agent-harness-preflight" "$1"
}

claude() {
  _agent_harness_preflight claude || return
  command claude --dangerously-skip-permissions "$@"
}

codex() {
  _agent_harness_preflight codex || return
  command codex --yolo "$@"
}

grok() {
  _agent_harness_preflight grok || return
  command grok "$@"
}

pi() {
  _agent_harness_preflight pi || return
  command pi "$@"
}

omp() {
  _agent_harness_preflight omp || return
  command omp "$@"
}

alias ccu='bunx ccusage --compact'

if [[ -r "$HOME/.config/chezmoi-work/shell.zsh" ]]; then
  source "$HOME/.config/chezmoi-work/shell.zsh"
fi
