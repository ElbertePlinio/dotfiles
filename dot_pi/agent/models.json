{
  "providers": {
    "anthropic": {
      "baseUrl": "http://127.0.0.1:8317",
      "api": "anthropic-messages",
      "apiKey": "$CLIPROXY_API_KEY",
      "modelOverrides": {
        "claude-fable-5-1": {
          "name": "Claude Fable 5.1"
        }
      },
      "models": [
        {
          "id": "claude-opus-5",
          "name": "Claude Opus 5",
          "reasoning": true,
          "input": ["text", "image"],
          "contextWindow": 1000000,
          "maxTokens": 128000
        }
      ]
    },
    "openai-codex": {
      "models": [
        {
          "id": "gpt-6-astra",
          "name": "GPT-6 Astra",
          "reasoning": true,
          "input": ["text", "image"],
          "contextWindow": 1050000,
          "maxTokens": 128000,
          "cost": {
            "input": 10,
            "output": 50,
            "cacheRead": 1,
            "cacheWrite": 12.5,
            "tiers": [
              {
                "inputTokensAbove": 272000,
                "input": 20,
                "output": 75,
                "cacheRead": 2,
                "cacheWrite": 25
              }
            ]
          },
          "thinkingLevelMap": {
            "off": null,
            "minimal": null,
            "xhigh": "xhigh",
            "max": null
          }
        }
      ]
    },
    "deepseek-official": {
      "name": "DeepSeek",
      "baseUrl": "https://api.deepseek.com",
      "api": "openai-completions",
      "apiKey": "!sed -n 's/^DEEPSEEK_API_KEY=//p' \"$HOME/.agents/deepseek.env\"",
      "models": [
        {
          "id": "deepseek-v4-flash",
          "name": "DeepSeek V4 Flash",
          "reasoning": true,
          "input": ["text"],
          "contextWindow": 1000000,
          "maxTokens": 384000,
          "cost": {
            "input": 0.14,
            "output": 0.28,
            "cacheRead": 0.028,
            "cacheWrite": 0
          },
          "compat": {
            "thinkingFormat": "deepseek",
            "requiresReasoningContentOnAssistantMessages": true
          },
          "thinkingLevelMap": {
            "minimal": "high",
            "low": "high",
            "medium": "high",
            "high": "high",
            "xhigh": "max"
          }
        }
      ]
    }
  }
}
