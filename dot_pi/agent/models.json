{
  "providers": {
    "anthropic": {
      "baseUrl": "http://127.0.0.1:8317",
      "api": "anthropic-messages",
      "apiKey": "$CLIPROXY_API_KEY",
      "modelOverrides": {
        "claude-fable-5": {
          "name": "Claude Fable 5"
        }
      },
      "models": [
        {
          "id": "claude-opus-5",
          "name": "Claude Opus 5",
          "reasoning": true,
          "input": ["text", "image"],
          "contextWindow": 1000000,
          "maxTokens": 128000
        }
      ]
    },
    "openai-codex": {
      "models": [
        {
          "id": "gpt-5.6-sol",
          "name": "GPT-5.6 Sol",
          "reasoning": true,
          "input": ["text", "image"],
          "contextWindow": 272000,
          "maxTokens": 128000,
          "cost": {
            "input": 5,
            "output": 30,
            "cacheRead": 0.5,
            "cacheWrite": 6.25,
            "tiers": [
              {
                "inputTokensAbove": 272000,
                "input": 10,
                "output": 45,
                "cacheRead": 1,
                "cacheWrite": 12.5
              }
            ]
          },
          "thinkingLevelMap": {
            "off": null,
            "minimal": null,
            "xhigh": "xhigh",
            "max": null
          }
        }
      ]
    },
    "ollama": {
      "name": "Ollama Cloud",
      "baseUrl": "https://ollama.com/v1",
      "api": "openai-completions",
      "apiKey": "$OLLAMA_CLOUD_API_KEY",
      "models": [
        {
          "id": "glm-5.2:cloud",
          "name": "GLM 5.2",
          "reasoning": true,
          "input": ["text"],
          "contextWindow": 976000,
          "maxTokens": 976000
        }
      ]
    }
  }
}
