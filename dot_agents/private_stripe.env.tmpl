# Stripe sandbox credentials for agent harnesses.
# Sandbox/test keys ONLY. Never put sk_live_* in this file.
# Edit via:  chezmoi edit ~/.agents/stripe.env && chezmoi apply ~/.agents/stripe.env
# Stored encrypted at rest: dot_agents/encrypted_private_stripe.env.age

export STRIPE_PUBLISHABLE_KEY={{ template "secret" "stripe_publishable_key" }}
export STRIPE_SECRET_KEY={{ template "secret" "stripe_secret_key" }}

# Restricted key for agent/MCP use. Mint at:
#   Dashboard > Developers > API keys > Create restricted key  (sandbox, write scopes)
# Prefer this over STRIPE_SECRET_KEY anywhere an agent or MCP server reads a credential.
# Must stay rk_test_*. A rk_live_* here gives agents reach over real money.
export STRIPE_RESTRICTED_KEY={{ template "secret" "stripe_restricted_key" }}
